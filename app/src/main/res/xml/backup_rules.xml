<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Back up the data plan database and settings; usage stats are
     re-read from the platform, so nothing sensitive beyond user preferences leaves the device. -->
<full-backup-content>
    <include domain="database" path="netpulse_database" />
    <include domain="file" path="datastore/netpulse_settings.preferences_pb" />
</full-backup-content>
